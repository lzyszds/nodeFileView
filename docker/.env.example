# =============================================================================
# filePreview Docker 环境变量（服务器 compose 部署用）
# =============================================================================
# 本地打包推送：
#   pnpm docker:deploy
#
# 服务器部署（只需 docker/ 目录 + 本文件）：
#   cp docker/.env.example docker/.env   # 改 TRUST_HOST、BASE_URL 等
#   docker compose -f docker/docker-compose.yml --env-file docker/.env pull
#   docker compose -f docker/docker-compose.yml --env-file docker/.env up -d
#   # 或仓库根目录：pnpm docker:up
#
# 说明：
# - 镜像从私有仓库 pull，不在服务器 build
# - 带「必改」的项上线前请务必修改
# =============================================================================

# —— 镜像（私有仓库 latest）——

IMAGE=registry.qqlink.live/qqlink_fileview:latest
# 数据目录：compose 默认用 Docker 命名卷 filePreview-data（见 docker-compose.yml volumes）
# 查看卷：docker volume inspect filePreview-data
# 若必须挂宿主机目录，需 chown 1000:1000 该目录，并自行改 compose 的 volumes 配置

# —— 控制台登录（管理后台，不影响 /onlinePreview 预览链路）——

# 是否启用控制台账号密码；Docker 生产建议 true
BASIC_AUTH_ENABLED=true
# 控制台登录用户名
BASIC_AUTH_USER=admin
# 控制台登录密码（已在代码 config.ts 写默认值；此处可覆盖）
BASIC_AUTH_PASS=A6T+%iOG_n{y*RXo

# —— 对外展示 / 接入 ——

# 预览站对外基址，供控制台展示与接入方参考（必改：改成你的域名）
# 正式： https://preview.qqlink.info
# 测试： https://preview-test.qqlink.info
BASE_URL=https://preview.qqlink.info

# —— 远程文件拉取白名单 / 黑名单（SSRF 防护，IM 场景必配）——

# 允许预览服务去拉取的远程 URL 主机白名单，支持 * 通配，逗号分隔（必改）
# 空=不额外限制（仍受 NOT_TRUST_HOST / 私网 IP 拦截）
# 示例：IM 文件 CDN / 对象存储域名
TRUST_HOST=*.my-imcloud.com,*qqlink.*
# 禁止拉取的主机/网段黑名单，支持 * 通配；默认含 localhost 与各私网段
NOT_TRUST_HOST=localhost,127.0.0.1,0.0.0.0,::1,169.254.*,192.168.*,10.*,172.16.*,172.17.*,172.18.*,172.19.*,172.20.*,172.21.*,172.22.*,172.23.*,172.24.*,172.25.*,172.26.*,172.27.*,172.28.*,172.29.*,172.30.*,172.31.*,100.64.*
# DNS 解析后若指向私网 IP 是否拒绝（生产建议 true）
BLOCK_PRIVATE_IP=true

# —— 嵌入与安全 ——

# 是否允许 iframe / Electron webview 嵌套预览页；QQLink 桌面端/手机端需 true
ALLOW_EMBED=true
# 前面有 Nginx / 负载均衡反代时设为 true，以便正确识别客户端 IP
TRUST_PROXY=true

# —— 上传与体积限制 ——

# 单文件上传 / 远程下载最大体积（MB）；超过 100MB 拒绝
MAX_UPLOAD_SIZE_MB=100
# 压缩包内单个条目解压上限（MB）
MAX_ARCHIVE_ENTRY_MB=100

# —— 预览 URL 加密（可选）——

# 是否对 /onlinePreview?url= 参数启用 AES-128-CBC 加密（默认关）
AES_ENABLED=false

# —— 限流（防刷；预览读路径可单独豁免）——

# 全局限流：每个 IP 在时间窗口内最多请求次数（主要约束控制台 / 管理 API）
RATE_LIMIT_MAX=300
# 限流时间窗口（毫秒），默认 60000 = 1 分钟
RATE_LIMIT_WINDOW_MS=60000
# 上传接口 /api/upload 单独限流（次/窗口）
RATE_LIMIT_UPLOAD_MAX=30
# 预览读路径（/onlinePreview、/api/cache 等）豁免全局限流；/api/remote 有单独限流
RATE_LIMIT_PREVIEW_EXEMPT=true
# /api/remote 单独限流（次/窗口），防滥用代拉远程文件
RATE_LIMIT_REMOTE_MAX=120
# 控制台登录 brute-force 限流（次/窗口）
RATE_LIMIT_LOGIN_MAX=10
# CORS 允许来源（逗号分隔）；空=生产时使用 BASE_URL
CORS_ORIGINS=

# —— 转码与远程下载（性能）——

# 同时进行 LibreOffice → PDF 转码的最大进程数；CPU 紧张可设为 1～2
CONVERT_MAX_CONCURRENT=2
# 单次 LibreOffice 转码超时（毫秒），默认 120000 = 2 分钟
CONVERT_TIMEOUT_MS=120000
# 从 IM/CDN 拉取远程文件的超时（毫秒）；弱网/mobile 建议 ≥120000
REMOTE_DOWNLOAD_TIMEOUT_MS=120000
# 远程文件磁盘命中后在内存中缓存的 TTL（毫秒），减轻重复 stat/读盘；0=关闭
HOT_REMOTE_CACHE_MS=60000

# —— 进程与 HTTP ——

# Node cluster worker 进程数；0 或 1=单进程，生产建议 2（与 CPU 核数匹配）
CLUSTER_WORKERS=2
# 是否对 HTML/JSON 等响应启用 gzip/br 压缩
COMPRESS_ENABLED=true
# 是否打印每条 HTTP 访问日志；生产建议 false 以减少磁盘 I/O
LOG_REQUESTS=false

# —— 磁盘缓存 TTL / 容量 ——

# 转码 PDF 缓存保留天数（按文件 mtime）；0=永不过期（仅靠容量回收）
CACHE_TTL_DAYS=7
# 远程文件磁盘缓存保留天数（按 meta.cachedAt）；0=永不过期
REMOTE_CACHE_TTL_DAYS=7
# 临时文件（serve-/arc- 等）保留小时数
TEMP_TTL_HOURS=24
# 后台自动清理任务间隔（毫秒）；0=禁用定时清理
CACHE_CLEANUP_INTERVAL_MS=3600000
# 缓存总容量上限（MB，含转码+远程+临时）；0=不限制；生产建议 2048～8192
CACHE_MAX_MB=4096
