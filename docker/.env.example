# 复制为 docker/.env 后使用：
#   docker compose -f docker/docker-compose.yml --env-file docker/.env up -d --build

BASIC_AUTH_ENABLED=true
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change-me-strong-password

# 对外基址（可选，给接入方展示用）
BASE_URL=https://preview.example.com

# 允许远程预览的主机白名单（空=不额外限制，仍受 NOT_TRUST_HOST / 私网拦截）
# 示例对齐 kkFileView：
# TRUST_HOST=*.my-imcloud.com,*.chat.qqlink.*
TRUST_HOST=

# 禁止拉取的主机/网段（支持 *）
NOT_TRUST_HOST=localhost,127.0.0.1,0.0.0.0,::1,169.254.*,192.168.*,10.*,172.16.*,172.17.*,172.18.*,172.19.*,172.20.*,172.21.*,172.22.*,172.23.*,172.24.*,172.25.*,172.26.*,172.27.*,172.28.*,172.29.*,172.30.*,172.31.*,100.64.*

BLOCK_PRIVATE_IP=true
ALLOW_EMBED=true
TRUST_PROXY=false
