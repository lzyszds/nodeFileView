# 宿主机已 pnpm build 后使用（无 buildx / 避免 Mac 上 qemu 编译 Vite OOM）
# 用法见 scripts/docker-build.sh

FROM node:22-bookworm
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    libreoffice-writer \
    libreoffice-calc \
    libreoffice-impress \
    fonts-noto-cjk \
    ca-certificates \
    curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
RUN pnpm install --filter @filePreview/server --prod --frozen-lockfile

COPY apps/server/dist ./apps/server/dist
COPY apps/web/dist ./apps/web/dist
COPY locales ./locales
COPY apps/server/package.json ./apps/server/
COPY .env.example ./.env.example

RUN mkdir -p /app/data/uploads /app/data/cache /app/data/temp \
  && chown -R node:node /app

USER node

ENV NODE_ENV=production \
    PORT=6001 \
    HOST=0.0.0.0 \
    DATA_DIR=/app/data \
    LIBREOFFICE_PATH=soffice \
    TRUST_PROXY=true \
    RATE_LIMIT_MAX=300 \
    RATE_LIMIT_UPLOAD_MAX=30 \
    RATE_LIMIT_PREVIEW_EXEMPT=true \
    CONVERT_MAX_CONCURRENT=2 \
    CONVERT_TIMEOUT_MS=120000 \
    REMOTE_DOWNLOAD_TIMEOUT_MS=120000 \
    HOT_REMOTE_CACHE_MS=60000 \
    CLUSTER_WORKERS=2 \
    COMPRESS_ENABLED=true \
    LOG_REQUESTS=false \
    CACHE_TTL_DAYS=7 \
    REMOTE_CACHE_TTL_DAYS=7 \
    TEMP_TTL_HOURS=24 \
    CACHE_CLEANUP_INTERVAL_MS=3600000 \
    CACHE_MAX_MB=4096

EXPOSE 6001
VOLUME ["/app/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${PORT}/health" || exit 1

CMD ["node", "apps/server/dist/index.js"]
