PORT=8013
HOST=0.0.0.0
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=200
MAX_ARCHIVE_ENTRY_MB=100
# 控制台登录锁：本地开发默认关；Docker 启动时再开并注入密码
BASIC_AUTH_ENABLED=false
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=admin123
AES_ENABLED=false
AES_KEY=0123456789abcdef
AES_IV=0123456789abcdef
PREVIEW_PASSWORD=
BLOCK_PRIVATE_IP=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
LIBREOFFICE_PATH=soffice
CONVERT_TIMEOUT_MS=120000
TRUST_PROXY=false
ALLOW_EMBED=true

# 远程拉取（对齐 kkFileView 风格，Docker 注入）
BASE_URL=
TRUST_HOST=
NOT_TRUST_HOST=localhost,127.0.0.1,0.0.0.0,::1,169.254.*,192.168.*,10.*,172.16.*,172.17.*,172.18.*,172.19.*,172.20.*,172.21.*,172.22.*,172.23.*,172.24.*,172.25.*,172.26.*,172.27.*,172.28.*,172.29.*,172.30.*,172.31.*,100.64.*

DEMO_CONSOLE7_PATH=
DEMO_ARCHIVE8_PATH=
