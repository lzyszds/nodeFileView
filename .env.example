PORT=8013
HOST=0.0.0.0
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=200
BASIC_AUTH_ENABLED=false
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=admin123
AES_ENABLED=false
AES_KEY=0123456789abcdef
AES_IV=0123456789abcdef
PREVIEW_PASSWORD=
BLOCK_PRIVATE_IP=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
LIBREOFFICE_PATH=soffice
CONVERT_TIMEOUT_MS=120000
TRUST_PROXY=false
# 允许 iframe / Electron <webview> 嵌入预览（false 时仅同域可嵌）
ALLOW_EMBED=true

# 本地开发：用于“demo UI 一比一还原”的模板 HTML 路由/替换
# 需要你把 demo（7）/（8）文件放在本机路径，并把这里指向对应文件
