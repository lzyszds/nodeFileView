# =============================================================================
# filePreview 本地开发环境变量
# =============================================================================
# 用法：cp .env.example .env
# Docker 部署请改用 docker/.env.example → docker/.env
# =============================================================================

# —— 服务监听 ——

# HTTP 服务端口
PORT=6001
# 绑定地址；0.0.0.0 表示所有网卡
HOST=0.0.0.0
# 数据根目录（上传 / 转码缓存 / 远程缓存 / 临时文件 / 监控状态）
DATA_DIR=./data

# —— 上传与体积限制 ——

# 单文件上传 / 远程下载最大体积（MB）
MAX_UPLOAD_SIZE_MB=100
# 压缩包内单个条目解压上限（MB）
MAX_ARCHIVE_ENTRY_MB=100

# —— 控制台登录 ——

# 是否启用控制台账号密码；本地开发默认 false
BASIC_AUTH_ENABLED=false
# 控制台登录用户名
BASIC_AUTH_USER=admin
# 留空则使用代码内默认值（apps/server/src/config.ts）
BASIC_AUTH_PASS=

# —— 预览 URL 加密（可选）——

# 是否对 /onlinePreview?url= 启用 AES-128-CBC
AES_ENABLED=false
# AES 密钥（须 16 字节）
AES_KEY=0123456789abcdef
# AES 初始向量（须 16 字节）
AES_IV=0123456789abcdef
# 非空则启用预览口令（访问预览页需带 password= 参数）
PREVIEW_PASSWORD=

# —— 远程拉取安全 ——

# DNS 解析后若指向私网 IP 是否拒绝
BLOCK_PRIVATE_IP=true
# 允许拉取的远程主机白名单（* 通配，逗号分隔；空=不额外限制）
TRUST_HOST=
# 禁止拉取的主机/网段黑名单
NOT_TRUST_HOST=localhost,127.0.0.1,0.0.0.0,::1,169.254.*,192.168.*,10.*,172.16.*,172.17.*,172.18.*,172.19.*,172.20.*,172.21.*,172.22.*,172.23.*,172.24.*,172.25.*,172.26.*,172.27.*,172.28.*,172.29.*,172.30.*,172.31.*,100.64.*

# —— 限流 ——

# 全局限流：每 IP 每窗口最大请求数
RATE_LIMIT_MAX=300
# 限流时间窗口（毫秒）
RATE_LIMIT_WINDOW_MS=60000
# 上传接口单独限流
RATE_LIMIT_UPLOAD_MAX=30
# 预览读路径是否豁免全局限流
RATE_LIMIT_PREVIEW_EXEMPT=true
RATE_LIMIT_REMOTE_MAX=120
RATE_LIMIT_LOGIN_MAX=10
CORS_ORIGINS=

# —— 转码与远程下载 ——

# LibreOffice 可执行文件路径（Docker 内为 soffice）
LIBREOFFICE_PATH=soffice
# 单次转码超时（毫秒）
CONVERT_TIMEOUT_MS=120000
# 同时转码进程数上限
CONVERT_MAX_CONCURRENT=2
# 远程文件下载超时（毫秒）
REMOTE_DOWNLOAD_TIMEOUT_MS=120000
# 远程缓存内存热读 TTL（毫秒）；0=关闭
HOT_REMOTE_CACHE_MS=60000

# —— 进程与 HTTP ——

# cluster worker 数；本地开发 0=单进程
CLUSTER_WORKERS=0
# 响应 gzip/br 压缩
COMPRESS_ENABLED=true
# 是否打印每条 HTTP 访问日志
LOG_REQUESTS=false
# 是否信任反代 X-Forwarded-* 头
TRUST_PROXY=false
# 是否允许 iframe / webview 嵌套预览
ALLOW_EMBED=true

# —— 磁盘缓存 ——

# 转码 PDF 缓存保留天数；0=不按时间过期
CACHE_TTL_DAYS=7
# 远程文件缓存保留天数
REMOTE_CACHE_TTL_DAYS=7
# 临时文件保留小时数
TEMP_TTL_HOURS=24
# 后台清理间隔（毫秒）；0=禁用
CACHE_CLEANUP_INTERVAL_MS=3600000
# 缓存总容量上限（MB）；0=不限制
CACHE_MAX_MB=0

# —— 对外展示 ——

# 预览站对外基址（可选）
BASE_URL=

# —— 本地 demo 页面（可选，一般留空）——

# 旧版 demo 控制台 HTML 路径
DEMO_CONSOLE7_PATH=
# 旧版 demo 压缩包路径
DEMO_ARCHIVE8_PATH=
